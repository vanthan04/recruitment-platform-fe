# Fallback origin used by every service when its dedicated *_SERVICE_URL below is not set.
BACKEND_URL=http://localhost:8080

# Optional per-service overrides — set these when each backend domain lives on its own origin.
# All routes are versioned under /api/v1 on top of whichever origin resolves per service.
AUTH_SERVICE_URL=
USERS_SERVICE_URL=
COMPANIES_SERVICE_URL=
CATEGORIES_SERVICE_URL=
JOBS_SERVICE_URL=
