# Backend origin. Single NestJS monolith today; if this ever splits into
# real microservices, the plan is a gateway (nginx) unifying them back into
# one origin, so this stays a single var either way.
BACKEND_URL=http://localhost:8080

# Same origin, exposed to the browser — only the realtime chat socket needs
# this (opened client-side, so it can't go through the server-only BACKEND_URL).
NEXT_PUBLIC_BACKEND_URL=http://localhost:8080
